# ===================================================================
# Voxly AI Voice Sales Bot — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ===================================================================

# -------------------------------------------------------------------
# Server
# -------------------------------------------------------------------
PORT=3000
# Bind address. Use 0.0.0.0 in containers/PaaS so the proxy can reach it.
HOST=0.0.0.0

# -------------------------------------------------------------------
# AI provider (required for real conversations and summaries)
# -------------------------------------------------------------------
# Google Gemini API key from https://aistudio.google.com/apikey
# (AI Studio keys look like "AIza..."). Leave blank to run without AI —
# the UI will then show a clear configuration error instead of fake replies.
GEMINI_API_KEY=

# Main model, then fallbacks used if a model name is unavailable.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash

# Credential style: "auto" (default) tries ?key=<GEMINI_API_KEY> first and
# falls back to Authorization: Bearer <token> on 401/403. Pin it with
# GEMINI_AUTH_MODE=key or GEMINI_AUTH_MODE=bearer if you prefer a single mode.
# GEMINI_AUTH_MODE=auto

# Optional OpenAI fallback provider (used only if GEMINI_API_KEY is empty,
# or when AI_PROVIDER=openai).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# auto | gemini | openai
AI_PROVIDER=auto
AI_TIMEOUT_MS=30000

# -------------------------------------------------------------------
# Storage
# -------------------------------------------------------------------
# Directory for the SQLite database and audio recordings.
# On Render/Railway/Fly point this at your persistent volume, e.g. /data
# DATA_DIR=voice-sales-bot/data

# Optional: require this token for DELETE /api/calls/:id and GET /api/export.
# Send it as the x-admin-token header. Leave blank to allow them unauthenticated
# (single-tenant demo mode).
# ADMIN_TOKEN=

# -------------------------------------------------------------------
# Limits (defaults shown)
# -------------------------------------------------------------------
# MESSAGE_MAX_LENGTH=2000
# JSON_BODY_MAX_BYTES=131072
# RECORDING_MAX_BYTES=26214400
# HISTORY_LIMIT=200
# MAX_TURNS_PER_CALL=60
# AI_REQUESTS_PER_MINUTE=40
# ACTIVE_CALL_TTL_MINUTES=30
