# ===================================================================
# Voxly AI Voice Sales Bot — Environment Configuration
# ===================================================================

# PORT: Server port (default: 3000)
PORT=3000

# -------------------------------------------------------------------
# AI Model Configuration
# -------------------------------------------------------------------
# Google Gemini API Key (Recommended)
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=AQ.Ab8RN6LFWj8xqQESP8L9k2qOg1rXEi7g467Psce1DV8m-IY9_A

# Gemini Model name (Default: gemini-2.0-flash, Fallback: gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Alternative: OpenAI API Key (Optional)
# If provided, can be toggled in settings or used if Gemini key is absent
# OPENAI_API_KEY=sk-...

# -------------------------------------------------------------------
# Offline Simulation Mode
# -------------------------------------------------------------------
# When set to true (default), the app provides transparent offline demo simulation
# with explicit UI badges if no API key is provided, enabling quick testing.
# Set to false to strictly enforce real AI API responses.
ALLOW_OFFLINE_DEMO=true
