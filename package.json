{
  "name": "voice-sales-bot",
  "version": "2.0.0",
  "private": true,
  "description": "Voxly — AI Voice Sales Bot with live voice conversations, recordings, AI summaries and call history",
  "type": "module",
  "main": "voice-sales-bot/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning voice-sales-bot/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch voice-sales-bot/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test voice-sales-bot/tests/*.test.js",
    "check": "node --check voice-sales-bot/server.js && node --check voice-sales-bot/public/app.js",
    "verify:ai": "node --disable-warning=ExperimentalWarning voice-sales-bot/scripts/verify-ai.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {}
}
